# ==============================================================================
# VerifyVoice - Environment Variable Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In production, set these variables in your deployment hosting platform.
# DO NOT COMMIT PRIVATE TOKENS OR SECRETS TO THIS FILE.

# Frontend ML Backend Endpoint
# Local: http://127.0.0.1:8000
# Production: https://<your-backend-domain>
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend Server Host & Port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated for multiple origins)
# Example: http://localhost:3000,http://127.0.0.1:3000,https://verifyvoice.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Optional Next.js internal backend rewrite target (for containerized monorepos)
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
